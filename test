<!-- 1. 引入D3库 -->
<script src="https://d3js.org/d3.v7.min.js"></script>

<!-- 2. 写D3代码 -->
<script>
// 选中页面容器，创建SVG画布
const svg = d3.select("body")
  .append("svg")
  .attr("width", 200)
  .attr("height", 200);

// 画一个圆形（数据+图形绑定）
svg.append("circle")
  .attr("cx", 100)   // 圆心x坐标
  .attr("cy", 100)   // 圆心y坐标
  .attr("r", 50)     // 半径
  .style("fill", "steelblue"); // 颜色
</script>
